# ─── Delphi Agent Arena — competition-testnet ────────────────────────────────
# Copy this file to `.env` and fill in the two secrets below.
# The SDK reads these variables automatically (it loads .env on import).

# Network: testnet | mainnet | competition-testnet
DELPHI_NETWORK=competition-testnet

# Signing method: private_key | cdp_server_wallet
DELPHI_SIGNER_TYPE=private_key

# Your wallet private key (hex). Controls your leaderboard identity — keep secret.
# 0x prefix optional; the SDK normalizes it.
WALLET_PRIVATE_KEY=

# Delphi REST API key. Generate a TESTNET key (competition shares the testnet API):
#   https://delphi-api-access.gensyn.ai/
DELPHI_API_ACCESS_KEY=

# ─── Optional knobs (safe defaults; uncomment to override) ───────────────────
# Log verbosity: debug | info | warn | error
# LOG_LEVEL=info

# Max markets pulled per scan
# MARKET_SCAN_LIMIT=50

# Heartbeat interval (minutes) for the long-running `npm start` / Railway worker
# HEARTBEAT_MINUTES=15

# ─── Signal layer (npm run signal) ───────────────────────────────────────────
# Fixed probe size (shares) for the read-only slippage quote. Same size across
# markets so their slippage is comparable.
# PROBE_SHARES=1

# Edge threshold (probability terms) to flag an outcome as a buy candidate (the *).
# MIN_EDGE=0.05

# If set, append every signal as JSON Lines here so scheduled runs build a history
# you can diff over time. Left unset = console logging only.
# SIGNAL_LOG_FILE=logs/signals.jsonl

# Manual probability overrides live in `manual-overrides.json` (copy the .example).

# ─── Advanced overrides (leave unset — network defaults are baked into the SDK) ─
# Dedicated RPC endpoint. STRONGLY recommended for 24/7 operation — the SDK's
# default is a shared public endpoint that rate-limits and intermittently fails.
# Get a free Gensyn-testnet URL from Alchemy and paste it here.
# GENSYN_RPC_URL=

# Read retry/backoff (applies to every RPC + REST read). Defaults shown.
# RETRY_MAX=4          # attempts after the first try (4 → 5 total)
# RETRY_BASE_MS=300    # first backoff delay
# RETRY_MAX_MS=5000    # cap on any single backoff delay

# GENSYN_CHAIN_ID=
# DELPHI_TOKEN_ADDRESS=
# DELPHI_GATEWAY_CONTRACT=
# DELPHI_SUBGRAPH_URL=
